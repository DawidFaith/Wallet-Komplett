# Bright Data Web Unlocker (Instagram-Profil-Verifizierung)
# API-Key unter: https://brightdata.com → API & Integrations → API Token
BRIGHTDATA_API_KEY=your_brightdata_api_key
# Zone-Name aus dem Bright Data Dashboard (Standard: web_unlocker1)
BRIGHTDATA_ZONE=web_unlocker1

# Thirdweb Configuration
NEXT_PUBLIC_TEMPLATE_CLIENT_ID=your_thirdweb_client_id

# Basescan API Key für Base-Chain-Transaktionend
# Beantrage einen kostenlosen API-Key auf https://basescan.org/apis
NEXT_PUBLIC_BASESCAN_API_KEY=your_basescan_api_key

# Stripe Configuration (D.FAITH Credits per Kreditkarte kaufen, EUR)
#
# Test- UND Live-Keys werden akzeptiert — erst mit sk_test_/pk_test_ und
# Stripe-Testkarten (4242 4242 4242 4242) durchtesten, danach auf sk_live_/
# pk_live_ umstellen. Test- und Live-Modus haben in Stripe getrennte
# Webhook-Secrets, beim Umstieg also STRIPE_WEBHOOK_SECRET mit umstellen.
#
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxx (oder pk_live_…)
# - STRIPE_SECRET_KEY=sk_test_51xxxxxxx (oder sk_live_…)
# - STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx
#
# Webhook-URL in Stripe (Dashboard → Developers → Webhooks) eintragen:
#   https://app.dawidfaith.de/api/stripe-webhook
# Benötigtes Event:
# - payment_intent.succeeded